{
  "expo": {
    "name": "MineMap",
    "slug": "MineMap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/AppIcon.png",
    "scheme": "minemap",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-maps"
        ]
      }
    },
    "permissions": [
      "AUDIO_RECORDING"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.MineMap",
      "icon": "./assets/images/AppIcon_ios.png",
      "config": {
        "googleMapsApiKey": "AIzaSyDtKbMcIWXrp1atB4rKFB6kma6ZB0xl1Ec"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses your location to show nearby stores.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app uses your location in the background to track deliveries.",
        "NSMicrophoneUsageDescription": "This app uses your microphone to record audio.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photos to upload images.",
        "NSCameraUsageDescription": "This app needs access to your camera to take photos."
      }
    },
    "android": {
      "versionCode": 1,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDtKbMcIWXrp1atB4rKFB6kma6ZB0xl1Ec"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/AppIcon.png",
        "backgroundColor": "#1ac7a1"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.MineMap",
      "googleServicesFile": "./google-services.json",
      "useNextNotificationsApi": true,
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          }
        }
      ],
      "expo-router",
      "sentry-expo",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/AppIcon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1ac7a1"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "This app needs location access to alert you when near saved locations.",
          "locationAlwaysPermission": "This app needs background location access for proximity alerts.",
          "locationWhenInUsePermission": "This app needs location access for proximity detection.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications"
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "sentryDsn": "https://a3d0364bcf73b960fc8068bd7cf778a5@o4509879370907648.ingest.us.sentry.io/4510428523134976",
      "router": {},
      "eas": {
        "projectId": "62c1d064-b5f9-4095-939b-346216a40d19"
      }
    },
    "owner": "bingo.dev"
  }
}
